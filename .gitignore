.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# 编译输出
*.apk
*.aab
*.unitypackage
*.app
*.exe
*.dll
*.so
*.dylib

# 编辑器运行时生成的设置
ProjectSettings/ManuallyReloadSettings.asset

# Crash 与诊断
sysinfo.txt
*.stackdump

# 本地工具缓存
.dotnet-home/
